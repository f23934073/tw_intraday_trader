# Provider 選擇：mock（預設）或 shioaji
# PROVIDER=mock

# Shioaji 登入資訊（僅 PROVIDER=shioaji 時需要）
# SHIOAJI_API_KEY=your_api_key_here
# SHIOAJI_SECRET=your_secret_key_here

# 歷史回測收盤後增量同步（Asia/Taipei）
# BACKTEST_INCREMENTAL_SYNC_ENABLED=true
# BACKTEST_INCREMENTAL_SYNC_CLOSE_TIME=14:30
# BACKTEST_INCREMENTAL_SYNC_POLL_SECONDS=60
# BACKTEST_INCREMENTAL_SYNC_OVERLAP_DAYS=1
# BACKTEST_ACTIVE_JOB_STALE_MINUTES=30
# BACKTEST_DATABASE_BACKEND=postgresql
# BACKTEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/tw_intraday_trader
# 測試專用 PostgreSQL；fixture 會刪除此 database 的 backtest schema，勿指向開發／正式 DB
# TEST_POSTGRES_DSN=postgresql://user:password@127.0.0.1:5432/tw_intraday_trader_test

# LOCAL_PAPER Journal persistence: memory（預設）或 postgresql
# TRADING_JOURNAL_BACKEND=memory
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/tw_intraday_trader
# TRADING_POSTGRES_POOL_MIN_SIZE=1
# TRADING_POSTGRES_POOL_MAX_SIZE=4
# TRADING_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
